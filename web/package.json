    "@needle-tools/helper": "^1.11.4",
    "@types/node": "24.10.1",
    "@types/three": "0.169.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-basic-ssl": "2",
    "playwright": "1.56.1",
    "tsx": "4.20.6",
    "typescript": "^5.0.4",
    "vite": "8.1.7"
  },
  "overrides": { "rolldown": "1.1.4" },
